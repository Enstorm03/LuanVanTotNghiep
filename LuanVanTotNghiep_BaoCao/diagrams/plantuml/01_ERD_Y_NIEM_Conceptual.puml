@startuml ERD_Y_NIEM_CONCEPTUAL
' So do ERD Y niem - He thong Enstorm Perfume
' Huong dan: Copy code nay vao PlantUML Online
' LUU Y: PlantUML khong ho tro Chen notation truc tiep
' De ve Chen notation chuan (hinh chu nhat, hinh thoi, hinh oval)
' vui long su dung Draw.io voi file .drawio da co san

title So do ERD Y niem (Conceptual Model)\nHe thong Enstorm Perfume

skinparam entity {
  BackgroundColor #dae8fc
  BorderColor #6c8ebf
}

' ========== ENTITIES ==========

entity "NGUOI DUNG" as user
entity "NHAN VIEN" as employee
entity "SAN PHAM" as product
entity "DON HANG" as order
entity "DANH MUC" as category
entity "THUONG HIEU" as brand
entity "SU KIEN" as event
entity "PHIEU NHAP KHO" as po
entity "CHI TIET PHIEU NHAP" as poDetail
entity "PHIEU GOI THAU" as tender
entity "BAO GIA NCC" as quote
entity "PHIEU DOI TRA" as return
entity "BIEN DONG KHO" as inventory
entity "DANH GIA SAN PHAM" as review
entity "LOGIN LOG" as log

' ========== RELATIONSHIPS (Y niem - chi co quan he) ==========

user -- order : "dat hang"
employee -- order : "xu ly"
order -- product : "chua"

product -- category : "thuoc danh muc"
product -- brand : "thuoc thuong hieu"
product -- event : "tham gia su kien"

po -- product : "nhap san pham"
poDetail -- po : "chi tiet phieu nhap"

product -- inventory : "bien dong kho"

employee -- tender : "tao phieu goi thau"
tender -- quote : "nhan bao gia"
user -- quote : "gui bao gia (NCC)"

order -- return : "doi tra hang"

user -- review : "viet danh gia"
product -- review : "duoc danh gia"

note top of user
  Doi tuong:
  - Khach hang
  - Nha cung cap
end note

note top of employee
  Doi tuong:
  - Admin
  - Director
  - Store Manager
  - Warehouse Staff
end note

note bottom of product
  Tam diem:
  - Quan ly kho FEFO
  - Han su dung
  - Hang loi
end note

note bottom of order
  Quy trinh:
  1. Dat hang
  2. Thanh toan
  3. Giao hang
  4. Hoan thanh
end note

note right of tender
  Quy trinh dau thau:
  1. Tao phieu
  2. NCC bao gia
  3. Chot thau
  4. Tao PO
end note

@enduml
